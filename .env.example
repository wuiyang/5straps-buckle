# ── 5straps Buckle (harness node) ───────────────────────────────────────────
BUCKLE_HOST=127.0.0.1
BUCKLE_PORT=4320
BUCKLE_SERVER_ID=local-dev
BUCKLE_SERVER_NAME=Local development machine
# One line naming the machine, shown in pickers.
BUCKLE_DESCRIPTION=Linux development box
# Prose telling a model when to prefer this node over its siblings.
BUCKLE_USAGE=Prefer for builds, tests, and repository work.

# Required by `buckle serve`. Not needed for `buckle mcp` or direct CLI use.
BUCKLE_AUTH_TOKEN=change-me
# The admin credential. Opens /setup, for owner policy, approvals, grants and workspace
# tokens. Must differ from the agent token; Buckle refuses to start otherwise. Empty leaves
# /setup unmounted. `buckle init` generates both.
BUCKLE_ADMIN_TOKEN=

# Largest request body Buckle accepts over HTTP, RPC, or stdio, in bytes.
BUCKLE_MAX_REQUEST_BYTES=1048576
# Timeout applied to a call that does not name its own, in milliseconds.
BUCKLE_DEFAULT_TIMEOUT_MS=30000
# Ceiling on any call's timeout, including one a request names for itself, in milliseconds.
BUCKLE_MAX_TIMEOUT_MS=300000

# Reads are free inside this root; anything outside asks for approval.
BUCKLE_WORKSPACE_ROOT=.
# Show the workspace to the agent as this path and hide the rest of the host. Shell tools
# then need bubblewrap. Empty shows the real path.
BUCKLE_WORKSPACE_MOUNT=
# Host directories still readable inside a mounted sandbox, for toolchains outside /usr
# (a pnpm store, an nvm install). Comma-separated.
BUCKLE_MOUNT_READ_ONLY=
# Explicit owner-authorized file/folder mounts (Linux bubblewrap, read-only).
# Mounted contents, including credentials, are readable by shell tools. No child-workspace inheritance.
# BUCKLE_MOUNTS='[{"source":"~/.docker/config.json","target":"~/.docker/config.json","readOnly":true}]'
BUCKLE_MOUNTS=
# Directories writable without asking. Empty means the first write anywhere asks once.
BUCKLE_SCRATCH_ROOTS=
# true refuses to remember write grants, so every directory asks every session.
BUCKLE_STRICT_WRITES=false

# auto | bubblewrap | seatbelt | none. `none` is an explicit acknowledgement that commands
# run unsandboxed. Without it, and with no sandbox available, the shell pack is withheld and
# `buckle manifest` says why. Host Git and language servers need separate opt-ins.
BUCKLE_SANDBOX=auto
# false withholds shell_exec and script_run even where a sandbox is available.
BUCKLE_ALLOW_SHELL=true
# Explicit opt-in to host Git/forge access, including tracked credential content and repository paths.
# Git config hardening does not enforce filesystem isolation; prefer sandboxed shell Git.
BUCKLE_ALLOW_HOST_GIT=false
# Explicit opt-in to unsandboxed language servers and local LSP attachment.
BUCKLE_ALLOW_HOST_LSP=false
# Private workspace copies require Linux Bubblewrap. false explicitly uses shared-workspace history.
BUCKLE_SHELL_ISOLATION=true
# Maximum captured bytes per private snapshot; not a live filesystem quota.
BUCKLE_ISOLATION_MAX_BYTES=268435456
# Optional built-in pack allowlist. Set browser for browser-only access; plugins are excluded.
BUCKLE_PACKS=
# Git-independent restore history; database bytes. Temporary SQLite journals need extra space.
BUCKLE_HISTORY_MAX_BYTES=1073741824
BUCKLE_HISTORY_RETENTION_DAYS=30
# Optional CLI message/stage label for grouping tool checkpoints.
BUCKLE_STAGE_ID=
# Owner opt-in; host restrictions still disable shell networking.
BUCKLE_SHELL_NETWORK=false
# Optional absolute path to trusted Varlock outside the workspace. Returns validity only.
BUCKLE_ENV_VALIDATOR_COMMAND=

# The owner's policy. Patterns one per line inside double quotes, or separated by ;;
# Commands are shell-word globs on the parsed command line, e.g. pnpm {build,test} * or
# {curl,wget}; deny wins, and an allow list admits only the whole lines it names.
# `buckle policy` stores more of the same in the state directory, and the shares are unioned.
BUCKLE_COMMAND_ALLOW=
BUCKLE_COMMAND_DENY=
# Commands that ask before running, added to the built-in destructive list, e.g.
# terraform destroy *  Nothing here removes a built-in, and none of them offers "always".
BUCKLE_COMMAND_DESTRUCTIVE=
# Approved hosts and URL prefixes, comma-separated: localhost:3000, *.example.com,
# https://app.example.com/admin. When set, only these are reached by fetch and browser.
BUCKLE_NETWORK_ALLOW=
# Hostnames web_fetch may reach even when they resolve to a private address; a literal private address still asks.
# Takes the approved list's host patterns: *.internal.test covers the apex and every subdomain, a port only when named.
# Keep a pattern to a private zone you control: *.com would exempt every .com name from the private-address check.
BUCKLE_ALLOWED_HOSTS=
BUCKLE_BRAVE_SEARCH_API_KEY=
# The owner's forge credential. Absent withholds the whole forge pack, naming this
# variable, rather than failing partway through a commit-push-review sequence. Never
# visible to a tool.
BUCKLE_FORGE_GITHUB_TOKEN=
# The forge API root. Configurable so a test server and an Enterprise install take one
# path. The git host is derived by dropping a leading api., e.g. api.github.com serves
# github.com.
BUCKLE_FORGE_GITHUB_API_URL=https://api.github.com
# The identity every forge commit carries, without writing anything into the workspace's
# git config. Expects "Name <email>".
BUCKLE_FORGE_GIT_AUTHOR=5straps agent <agent@5straps.local>
BUCKLE_AGENT_BROWSER_COMMAND=agent-browser
# true opens a visible browser window. Headless by default, since a node often has no display.
# A per-call --headed flag still wins over this.
BUCKLE_BROWSER_HEADED=false
# Fresh browser sessions ignore ambient AGENT_BROWSER_* configuration and saved profiles.
# BUCKLE_ENV_FILE names the file Buckle reads its settings from, an absolute path. It belongs in the
# shell or the MCP config's env, never in an environment file: a file cannot name another one, so a
# BUCKLE_ENV_FILE line here stops this file from loading. Left unset, Buckle reads buckle.env in the
# state directory (BUCKLE_STATE_DIR, or ~/.5straps/buckle), which is where `buckle init` writes it.
# BUCKLE_ENV_FILE=/absolute/path/to/buckle.env

# Approval wait: milliseconds (60000 = one minute), forever, or 0 for immediate retry instructions.
# Default is 15000. Restart Buckle after changing. Client/proxy timeouts still apply.
# During the wait an approval is taken from any route: a y/n in the terminal running `buckle
# serve`, `buckle approve` elsewhere, or a POST to /setup/approvals.
BUCKLE_APPROVAL_TIMEOUT_MS=15000
# Optional. Buckle POSTs pending approvals here so a person can be reached away from the
# machine. Point it at Rings, <rings>/api/v1/buckle-approvals, and they appear in Visual's
# Approvals pane; the request carries BUCKLE_REPORT_TOKEN as its bearer. Any other relay
# works too: it presents the choice, then approves by posting back to /setup/approvals.
BUCKLE_APPROVAL_WEBHOOK=

# Where every refused call is posted as it happens, with its own bearer token. Point it at
# Rings: <rings>/api/v1/buckle-reports with RINGS_BUCKLE_REPORT_TOKEN. Both or neither.
BUCKLE_REPORT_URL=
BUCKLE_REPORT_TOKEN=

# Grants, plugins, pending approvals, the policy, and the action log. Defaults to
# ~/.5straps/buckle. No tool can read it and the sandbox hides it from every command.
# Read the log back with `buckle log`. Like BUCKLE_ENV_FILE this belongs in the shell, not here:
# this file lives inside the state directory, so it cannot also name one, and a line here stops it
# from loading. Leave it unset to use the default.
# BUCKLE_STATE_DIR=/absolute/path/to/state
BUCKLE_SKILLS_DIRS=
