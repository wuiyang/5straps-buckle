# Buckle node settings, which every workspace on the node shares. Buckle reads buckle.env in its state
# directory (~/.5straps/buckle/buckle.env by default) or the file BUCKLE_ENV_FILE names in the shell,
# and never a .env in the working directory. `buckle init` writes it with a fresh admin
# credential. Or copy this one there, chmod 600. Only BUCKLE_ names are read, and a value set
# in the shell wins over the file's, except for the workspace defaults ("Every workspace's" below,
# and the block at the end) and the decision AI keys and URLs: those are read from this file alone.
# Each workspace's own settings are in its workspace.json: `buckle workspace set` and `buckle policy`
# change them (docs/workspaces-02.md).

# Where `buckle serve` listens. No TLS: put a proxy in front for anything beyond this host.
BUCKLE_HOST=127.0.0.1
BUCKLE_PORT=4320
# Shown in `buckle manifest`; the id also names the node in its relay and report posts.
BUCKLE_SERVER_ID=local-dev
BUCKLE_SERVER_NAME=Local development machine
BUCKLE_DESCRIPTION=Linux development box
# Tells a model when to prefer this node over its siblings.
BUCKLE_USAGE=Prefer for builds, tests, and repository work.

# The admin credential: `buckle workspace` needs it to change workspaces and mint their agent tokens.
# `buckle init` generates one; by hand, use a long random value.
BUCKLE_ADMIN_TOKEN=
# true, with BUCKLE_ADMIN_TOKEN set, serves the experimental admin HTTP face, /setup; off, it answers
# 404. There the admin credential can only deny an ask; approving needs a device key enrolled with
# `buckle keys enroll`. The local CLI never needs it.
BUCKLE_EXPERIMENTAL_ADMIN_HTTP=false

# Largest HTTP or stdio request body, and `buckle cp` file, in bytes; a call's default and maximum timeout, in ms.
BUCKLE_MAX_REQUEST_BYTES=1048576
BUCKLE_MAX_TRANSFER_BYTES=104857600
BUCKLE_DEFAULT_TIMEOUT_MS=30000
BUCKLE_MAX_TIMEOUT_MS=300000

# Toolchains outside /usr, which every sandbox binds read-only at their own path; never a mount.
BUCKLE_MOUNT_READ_ONLY=
# Every workspace's read-only mounts while it has none of its own (docs/mounts.md), as JSON, such
# as [{"source":"~/.docker/config.json","target":"~/.docker/config.json","readOnly":true}]. Shell
# tools can read them, credentials included.
BUCKLE_MOUNTS=
# Every workspace's folders writable without asking, at their own path, while it has no mount of
# its own. Empty: the first write to each asks.
BUCKLE_SCRATCH_ROOTS=
# true offers only "once" for every workspace's writes, so no write approval is remembered.
BUCKLE_STRICT_WRITES=false

# auto | bubblewrap | seatbelt | none. With no sandbox available, the shell pack is withheld and
# `buckle manifest` says why. `none` acknowledges unsandboxed commands: a shell command can then
# read the state directory, this file included, without an ask.
BUCKLE_SANDBOX=auto
# Every workspace's shell.isolation: shell tools on private workspace copies (Linux bubblewrap),
# capped in bytes; false shares the workspace.
BUCKLE_SHELL_ISOLATION=true
BUCKLE_ISOLATION_MAX_BYTES=268435456
# Git-backed change history rolling bytes. Workspace history settings choose turns and the file cap.
BUCKLE_HISTORY_MAX_BYTES=268435456
# BUCKLE_HISTORY_RETENTION_DAYS=30 # isolated-shell recovery copies only
# A stage label CLI tool calls carry, grouping their checkpoints.
BUCKLE_STAGE_ID=
# Every workspace's shell.network: true lets shell commands reach the network while no approved
# URL list is set.
BUCKLE_SHELL_NETWORK=false
# A trusted Varlock executable, by absolute path, for the environment pack; unset withholds it.
BUCKLE_ENV_VALIDATOR_COMMAND=

# Every workspace's approved hosts, which join BUCKLE_NETWORK_ALLOW while it has no list of its own,
# so other hosts are refused. A host named exactly may resolve to a private address; one a wildcard
# covers may not, for web_fetch.
BUCKLE_ALLOWED_HOSTS=

# Adds web_search to the web pack.
BUCKLE_BRAVE_SEARCH_API_KEY=
# Decision AI keys and base URLs (docs/judge.md).
BUCKLE_JUDGE_API_KEY=
BUCKLE_JUDGE_BASE_URL=
BUCKLE_QUICK_JUDGE_API_KEY=
BUCKLE_QUICK_JUDGE_BASE_URL=
BUCKLE_SOCKET_API_KEY=
BUCKLE_SOCKET_BASE_URL=
# The owner's forge credential, never visible to a tool; absent withholds the forge pack.
BUCKLE_FORGE_GITHUB_TOKEN=
# The forge API root; the git host is that host without a leading api.
BUCKLE_FORGE_GITHUB_API_URL=https://api.github.com
# The "Name <email>" every forge commit carries, without touching the workspace's git config.
BUCKLE_FORGE_GIT_AUTHOR=5straps agent <agent@5straps.local>
# agent-browser, or its .exe or script where Buckle refuses a Windows shim; unset withholds it.
BUCKLE_AGENT_BROWSER_COMMAND=agent-browser
# Every workspace's browser.headed: true shows the browser window; a per-call --headed flag wins.
BUCKLE_BROWSER_HEADED=false
# Every workspace's browser.profile, browser.cdp, and browser.args. Unset, each session gets a fresh
# browser (docs/browser-login.md). A profile folder keeps logins; a DevTools port or URL attaches
# your own Chrome and stands alone; arguments are comma separated.
BUCKLE_BROWSER_PROFILE=
BUCKLE_BROWSER_CDP=
BUCKLE_BROWSER_ARGS=

# Buckle posts each pending ask here, with BUCKLE_REPORT_TOKEN as bearer: to Rings, the 5straps agent
# control plane (<rings>/api/v1/buckle-approvals), or any relay. It only announces.
BUCKLE_APPROVAL_WEBHOOK=

# Where the action log and each refused call are posted, with BUCKLE_REPORT_TOKEN as bearer. Set both
# or neither. Pairing with Rings (`buckle init --pair`) fills in these, the webhook, and the key.
BUCKLE_REPORT_URL=
BUCKLE_REPORT_TOKEN=
# The key Rings minted at pairing: posts to Rings go sealed, and decisions from Rings must be sealed.
BUCKLE_RINGS_APPROVAL_KEY=

# Set these two in the shell or the MCP config's env, never in this file: a BUCKLE_ENV_FILE line, or
# a BUCKLE_STATE_DIR line naming another directory, stops it from loading. BUCKLE_ENV_FILE names the
# settings file by absolute path; buckle mcp takes it only where it names a file in the state directory.
# BUCKLE_STATE_DIR moves the state directory (~/.5straps/buckle).
# BUCKLE_ENV_FILE=/absolute/path/to/buckle.env
# BUCKLE_STATE_DIR=/absolute/path/to/state
# Extra skill directories, comma-separated.
BUCKLE_SKILLS_DIRS=

# The stderr log: format (json or human), level (trace, debug, info, warn, error, or fatal),
# keys to omit, or content keys to keep. Credential-named keys stay redacted.
BUCKLE_LOG_FORMAT=
BUCKLE_LOG_LEVEL=
BUCKLE_LOG_OMIT_KEYS=
BUCKLE_LOG_ALLOW_KEYS=

# From the shell alone: `buckle client`'s key folder, ~/.5straps/client by default, and `buckle cp`'s
# node where none serves here.
# BUCKLE_CLIENT_DIR=/absolute/path/to/client
# BUCKLE_NODE_URL=http://127.0.0.1:4320

# Every workspace's defaults (docs/workspaces-03.md): a workspace takes each where its own settings
# hold no value. One with an allow list of its own (commands, interpreters, or URLs) uses it alone;
# the deny and destructive lists apply to every workspace. Read from this file alone, never from the
# shell or an MCP config's env; `buckle settings set` writes them. Globs are separated by ;;.
# BUCKLE_WORKSPACE_MOUNT=/workspace
# BUCKLE_PACKS=fs,web,shell
# BUCKLE_ALLOW_SHELL=true
# BUCKLE_ALLOW_CODE=true
# BUCKLE_ALLOW_HISTORY=true
# BUCKLE_ALLOW_HOST_GIT=false
# BUCKLE_ALLOW_HOST_LSP=false
# BUCKLE_COMMAND_ALLOW=pnpm {build,test} *;;git status
# BUCKLE_COMMAND_DENY=curl *;;wget *
# BUCKLE_COMMAND_DESTRUCTIVE=terraform destroy *
# BUCKLE_NETWORK_ALLOW=
# BUCKLE_ALLOWED_INTERPRETERS=
# BUCKLE_APPROVAL_TIMEOUT_MS=15000
# BUCKLE_APPROVAL_JUDGE=off
# BUCKLE_APPROVAL_JUDGE_PROVIDER=openai-compatible
# BUCKLE_APPROVAL_JUDGE_MODEL=gpt-6-luna
# BUCKLE_APPROVAL_JUDGE_STANDARD_SCRIPTS=npm test;;npx vitest *
# BUCKLE_APPROVAL_QUICK_JUDGE=off
# BUCKLE_APPROVAL_QUICK_JUDGE_MODEL=jev-latest
# BUCKLE_DELETE_IN_WORKSPACE=allow
# BUCKLE_MASS_DELETE_LIMIT=100

# Before workspaces. A 0.1 node kept its agent token and its folder here. The first command of this
# release reads both lines once, to move the node onto workspaces (docs/workspaces-04.md): the
# BUCKLE_WORKSPACE_ROOT line here is that move's input and nothing else. `buckle mcp` still takes
# BUCKLE_WORKSPACE_ROOT from its own process environment (an MCP config's env, or the shell) as the
# legacy pick of its workspace, never from this file; add --workspace to such a config instead.
# BUCKLE_AUTH_TOKEN=
# BUCKLE_WORKSPACE_ROOT=/absolute/path/to/project
