{
  "name": "@5straps/protocol",
  "version": "0.1.10",
  "description": "The versioned wire schemas Buckle speaks: tool manifests, invocations, approvals, policy, signed requests, and sealed envelopes.",
  "license": "Apache-2.0",
  "keywords": [
    "5straps",
    "protocol",
    "zod",
    "schema"
  ],
  "homepage": "https://github.com/wuiyang/5straps-buckle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuiyang/5straps-buckle.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/wuiyang/5straps-buckle/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./envelope": {
      "types": "./dist/envelope.d.ts",
      "default": "./dist/envelope.js"
    },
    "./signed-request": {
      "types": "./dist/signed-request.d.ts",
      "default": "./dist/signed-request.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
