{
  "name": "@5straps/runtime",
  "version": "0.1.11",
  "description": "The runtime primitives Buckle is built on: service lifetimes, async scopes, lifecycle, CLI interaction, logging, SQLite ownership, and Nitro adapters.",
  "license": "Apache-2.0",
  "keywords": [
    "5straps",
    "runtime",
    "nitro",
    "sqlite",
    "asynclocalstorage"
  ],
  "homepage": "https://github.com/wuiyang/5straps-buckle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuiyang/5straps-buckle.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/wuiyang/5straps-buckle/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "default": "./dist/sqlite/index.js"
    },
    "./nitro": {
      "types": "./dist/nitro/index.d.ts",
      "default": "./dist/nitro/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/types/tsconfig.json && tsc -p test/fixture/tsconfig.json"
  },
  "dependencies": {
    "db0": "0.4.1"
  },
  "peerDependencies": {
    "h3": "2.0.1-rc.32",
    "nitro": "3.0.260903-beta"
  },
  "peerDependenciesMeta": {
    "h3": {
      "optional": true
    },
    "nitro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "24.10.1",
    "crossws": "0.4.12",
    "h3": "2.0.1-rc.32",
    "hookable": "6.1.1",
    "nitro": "3.0.260903-beta",
    "srvx": "1.0.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zod": "4.6.7"
  }
}
