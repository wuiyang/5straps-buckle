{
  "name": "@5straps/buckle",
  "version": "0.1.0",
  "description": "Buckle: a sandboxed tool-execution node any AI harness can drive over CLI, MCP, or HTTP.",
  "license": "Apache-2.0",
  "keywords": [
    "5straps",
    "buckle",
    "mcp",
    "agent",
    "tools",
    "sandbox",
    "llm",
    "claude",
    "skills"
  ],
  "homepage": "https://github.com/wuiyang/buckle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuiyang/buckle.git",
    "directory": "harness-rpc"
  },
  "bugs": {
    "url": "https://github.com/wuiyang/buckle/issues"
  },
  "type": "module",
  "bin": {
    "buckle": "./dist/main.js"
  },
  "files": [
    "dist",
    ".output",
    "main.ts",
    "common",
    "cli",
    "mcp",
    "server",
    "skills",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "node scripts/build.mjs && node scripts/build-server.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "buckle": "tsx main.ts",
    "acceptance": "pnpm run build && node scripts/acceptance.mjs",
    "mcp-probe": "node scripts/mcp-probe.mjs"
  },
  "dependencies": {
    "@5straps/protocol": "workspace:*",
    "@5straps/runtime": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "h3": "2.0.1-rc.32",
    "hono": "4.13.5",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.1",
    "nitro": "3.0.260903-beta",
    "srvx": "1.0.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
