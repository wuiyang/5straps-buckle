{
  "name": "buckle-repo",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @5straps/buckle dev",
    "predev": "pnpm --filter @5straps/protocol build && pnpm --filter @5straps/runtime build",
    "test": "pnpm test:packages && pnpm test:scripts",
    "test:packages": "pnpm -r --workspace-concurrency=1 --no-bail test --maxWorkers=2",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "typecheck": "pnpm -r --no-bail typecheck",
    "pretest": "pnpm --filter @5straps/protocol build && pnpm --filter @5straps/runtime build",
    "pretypecheck": "pnpm --filter @5straps/protocol build && pnpm --filter @5straps/runtime build",
    "release:check": "pnpm check:runtime-pins && pnpm check:routes && pnpm typecheck && pnpm test && pnpm -r build && pnpm test:package && pnpm audit:release",
    "release": "node scripts/release/require-ci.mjs && pnpm release:check && pnpm -r publish --access public",
    "version:set": "pnpm --filter @5straps/protocol --filter @5straps/runtime --filter @5straps/buckle exec npm version",
    "test:package": "node scripts/release/packaged-smoke.mjs && node scripts/release/runtime-fixture-smoke.mjs",
    "audit:release": "pnpm audit --prod --audit-level=low && node scripts/release/audit-bundled.mjs",
    "check:runtime-pins": "node scripts/check-runtime-pins.mjs",
    "check:routes": "node scripts/check-duplicate-routes.mjs packages/runtime/test/fixture && node scripts/check-duplicate-routes.mjs packages/runtime/test/package-smoke && node scripts/check-duplicate-routes.mjs buckle"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "changelogen": "0.6.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "changelog": {
    "repo": "wuiyang/buckle",
    "noAuthors": true,
    "excludeAuthors": [
      ""
    ],
    "types": {
      "buckle": {
        "title": "Earlier Buckle changes"
      },
      "workbench": {
        "title": "Earlier workbench changes"
      },
      "tools": {
        "title": "Earlier tool changes"
      }
    }
  }
}
